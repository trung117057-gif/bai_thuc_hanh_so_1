
#include <stdio.h>


void int ucln(int a, int b) {
    while (b != 0) {
        int r = a % b;
        a = b;
        b = r;
    }
    return a;
}


 void int bcnn( int a,int  b) {
    if (a == 0 || b == 0) return 0;
    return (a * b) / ucln(a, b);
}

int main() {
    int a, b;
    printf("Nhap vao hai so nguyen dương a và b: ");
    if (scanf("%d %d", &a, &b) == 2 && a > 0 && b > 0) {
       int kq = bcnn(a, b);
        printf("Boi chung nho nhat của %d va %d là: %d\n", a, b, kq);
    } else {
        printf("Vui long nhap hai so nguyen duong hop le!\n");
    }
    return 0;
}
