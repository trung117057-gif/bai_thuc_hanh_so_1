
#include <stdio.h>

int main() {
    int n;
    printf("Nhập số lượng phần tử N: ");
    scanf("%d", &n);

    int a[n];
    for (int i = 0; i < n; i++) {
        printf("Nhập phần tử a[%d]: ", i);
        scanf("%d", &a[i]);
    }

   
    int max = a[0];

    
    for (int i = 1; i < n; i++) {
        if (a[i] > max) {
            max = a[i];
        }
    }
    printf("Số lớn nhất trong mảng là: %d\n", max);
    return 0;
}
